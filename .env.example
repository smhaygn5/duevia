# Public Arc Testnet configuration
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_ARC_RPC_FALLBACK_URL=https://arc-testnet.drpc.org
NEXT_PUBLIC_ARC_CHAIN_ID=5042002
NEXT_PUBLIC_ARC_EXPLORER_URL=https://testnet.arcscan.app

# Confirmed ownerless DueviaEscrowFactory on Arc Testnet.
NEXT_PUBLIC_DUEVIA_FACTORY_ADDRESS=0x8097847f00e47Da0Bc6628A3e500215AAeE1fFad

# Vercel-only server bridge to the private Duevia D1/R2 backend.
# The URL must use HTTPS. Never expose the bearer token as NEXT_PUBLIC_*.
DUEVIA_BACKEND_URL=
DUEVIA_BACKEND_BEARER_TOKEN=

# Deployment-only secret. Never expose this through NEXT_PUBLIC_*.
ARC_TESTNET_PRIVATE_KEY=
